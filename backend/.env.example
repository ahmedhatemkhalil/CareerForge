# =============================================================================
# CareerForge Backend — Railway environment variables
# Copy each key into Railway → your backend service → Variables
# =============================================================================

# --- Server ---
# Railway sets PORT automatically; fallback is 5000
PORT=5000
NODE_ENV=production

# --- Database (required) ---
# MongoDB Atlas or Railway MongoDB plugin connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/careerforge?retryWrites=true&w=majority

# --- Auth (required) ---
JWT_SECRET=replace-with-long-random-secret
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_SECRET=replace-with-another-long-random-secret

# --- URLs (required on Railway) ---
# Your deployed frontend URL (no trailing slash)
FRONTEND_URL=https://your-frontend.up.railway.app

# --- AI / Langflow (required for analysis, interviews, roadmaps) ---
# Public URL of your AI (Langflow) Railway service
LANGFLOW_URL=https://your-ai.up.railway.app
LANGFLOW_API_KEY=

# Flow IDs — copy from Langflow UI → each flow → API tab
LANGFLOW_FLOW_ID=
LANGFLOW_INTERVIEW_FLOW_ID=
LANGFLOW_PROMPT_ID=
LANGFLOW_ROADMAP_FLOW_ID=
LANGFLOW_ROADMAP_PROMPT_ID=

# Serper — job matching & learning resources (https://serper.dev)
SERPER_API_KEY=

# --- OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Stripe (optional — payments) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=

# --- Cloudinary (optional — file uploads / avatars) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Tests only (local / CI — do not set on Railway) ---
# MONGODB_TEST_URI=
