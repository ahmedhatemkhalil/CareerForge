# =============================================================================
# CareerForge Frontend — Railway environment variables
# Vite embeds these at BUILD time — set them in Railway before deploy/rebuild
# Railway → your frontend service → Variables
# =============================================================================

# Backend API base URL (required)
# Must include /api — use your deployed backend Railway URL
VITE_API_URL=https://your-backend.up.railway.app/api

# Google OAuth client ID (required for "Sign in with Google")
# Same client as backend GOOGLE_CLIENT_ID; add Railway frontend URL to
# Google Cloud Console → Authorized JavaScript origins & redirect URIs
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
