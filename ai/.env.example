# Langflow runtime (set in docker-compose or Railway)
LANGFLOW_HOST=0.0.0.0
LANGFLOW_PORT=7860
LANGFLOW_AUTO_LOGIN=false

# Optional: Gemini / OpenAI keys configured inside Langflow UI or here
# GOOGLE_API_KEY=
# OPENAI_API_KEY=

# Optional API key if you enable Langflow authentication
# LANGFLOW_API_KEY=
