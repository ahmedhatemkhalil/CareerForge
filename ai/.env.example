# =============================================================================
# CareerForge AI (Langflow) — Railway environment variables
# Railway → your AI service → Variables
# Also mount a Railway Volume at /app/langflow to persist flows
# =============================================================================

# Railway injects PORT — Langflow listens on it automatically
LANGFLOW_HOST=0.0.0.0
LANGFLOW_AUTO_LOGIN=false
LANGFLOW_SAVE_DB_IN_CONFIG_DIR=true
LANGFLOW_CONFIG_DIR=/app/langflow

# LLM keys — set here OR inside Langflow UI after first deploy
GOOGLE_API_KEY=
# OPENAI_API_KEY=

# Optional: if you enable Langflow API key auth, use the same value in backend LANGFLOW_API_KEY
# LANGFLOW_API_KEY=
