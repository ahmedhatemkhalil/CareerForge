# =============================================================================
# CareerForge AI (Langflow 1.9) — Railway environment variables
# Railway → your AI service → Variables
# =============================================================================

# REQUIRED on Railway:
# 1. Volume → Mount path: /data
# 2. Hobby plan → Settings → Deploy → RAM limit: 2 GB (recommended)
# 3. Variables below

RAILWAY_RUN_UID=0

LANGFLOW_HOST=0.0.0.0
LANGFLOW_AUTO_LOGIN=false
LANGFLOW_DATA_DIR=/data
LANGFLOW_CONFIG_DIR=/data
LANGFLOW_SAVE_DB_IN_CONFIG_DIR=true
LANGFLOW_DATABASE_URL=sqlite:////data/langflow.db
LANGFLOW_STORE_ENVIRONMENT_VARIABLES=true

# Superuser login (required when AUTO_LOGIN=false)
# LANGFLOW_SUPERUSER=admin
# LANGFLOW_SUPERUSER_PASSWORD=your-secure-password
# LANGFLOW_SECRET_KEY=long-random-string

# Reference only — you must also paste the key in each flow's Agent/Language Model node
GOOGLE_API_KEY=

# Import these flows in Langflow UI (original lfx flows):
#   ai/interview.langflow-1.9.json  → Agent + Prompt Template-Hk1hp
#   ai/cvAnalysis.json            → Agent + Prompt Template-RYlDM
#   ai/roadmap.json               → Language Model + Prompt-CFRoadmapV2
#
# ai/interview.json is the 1.3.4 fallback only — do not use on 1.9

# Optional: if you enable Langflow API key auth, use the same value in backend LANGFLOW_API_KEY
# LANGFLOW_API_KEY=
