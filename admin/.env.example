# =============================================================================
# CareerForge Admin — Railway deployment
# =============================================================================
#
# Service settings (Railway dashboard):
#   Root Directory: admin
#   Builder:        Dockerfile  (NOT Nixpacks — logs must show nginx, not "serve")
#   Port:           leave blank for auto-detect (uses Railway PORT at runtime)
#
# Variables (rebuild required after changing):
#   API_URL=https://your-backend.up.railway.app/api
#
# If deploy logs show "serve" and port 8080, Railway is ignoring the Dockerfile.
# Set Root Directory to "admin" and redeploy, or switch Builder to Dockerfile.
# =============================================================================

API_URL=https://your-backend.up.railway.app/api
